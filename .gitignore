*.pyc
**/*.pyc
__pycache__/
*__pycache__*
*.so
.vscode/

# Reconstruction run outputs (regenerable, often GB-scale)
runs/

# Large data assets (provided externally, symlinked in)
*.h5
*.pt
*.ply
*.npy
*.png

# Image / dataset directories (provided externally)
data/
dataset/
pretrained_gaussians/

# Build artifacts
build/
output/
*.egg-info/

# Archived legacy assets (preserved on disk, also in pre-gluemap-checkpoint branch)
_archive/

# COLMAP databases + sqlite WAL
*.db
*.db-shm
*.db-wal

# Videos / large media (provided externally)
*.mp4
*.MP4
*.mov
*.MOV
*.avi
*.mkv

# Model checkpoints / weights
*.pth
*.ckpt
*.safetensors
*.bin

